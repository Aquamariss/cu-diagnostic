# Порт веб-сервера
PORT=3000

# Ключ Claude API — включает персонализацию текстов результата и роадмапа.
# Без ключа сервис работает на шаблонных текстах.
ANTHROPIC_API_KEY=
# Модель и уровень effort (по умолчанию claude-opus-5-5 и low — ради скорости ответа)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# Пароль для /admin (логин любой). Без пароля админка выключена.
ADMIN_PASSWORD=

# Ссылки
PRIVACY_POLICY_URL=https://cityuniversity.ru/policy
CONSULTATION_URL=https://cityuniversity.ru/school-urban-producers
SCHOOL_URL=https://cityuniversity.ru/school-urban-producers

# Папка для хранения заявок (JSON-файл)
# DATA_DIR=./data
